PORT=3000

# Supabase project and server-only database configuration.
SUPABASE_URL=https://your-project.supabase.co
# Server-only key. Never put an sb_secret_ key in the browser or commit it.
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=admin@example.com
# Generate this hash locally with `npm run admin:password`; never store a plaintext password here.
ADMIN_PASSWORD_HASH=

# Public HTTPS URL where Vapi can reach this application.
PUBLIC_BASE_URL=https://your-public-domain.example

# Vapi private API key. The server uses this for Vapi API requests.
VAPI_API_KEY=
# Stored locally only; add the Google/Gemini provider key directly in the Vapi dashboard.
GEMINI_API_KEY=
# Optional: existing Vapi phone number to attach to the assistant.
VAPI_PHONE_NUMBER_ID=
# Required: shared webhook secret, also configured in Vapi's header credential.
VAPI_WEBHOOK_SECRET=
# Required: ID of the Vapi header-auth credential that sends x-vapi-secret.
VAPI_WEBHOOK_CREDENTIAL_ID=

# n8n production webhook URL from the imported workflow.
N8N_WEBHOOK_URL=
# Match this with the n8n Header Auth credential value.
N8N_WEBHOOK_SECRET=
# Your Twilio-owned SMS sender in international E.164 format, e.g. +31201234567.
N8N_SMS_FROM_NUMBER=
